schema {
    query: Query
    mutation: Mutation
}

# java.time.LocalDateTime implementation
scalar LocalDateTime

# java.lang.Long implementation
scalar Long

type Query {
    getAllNews: [News]
    getAllNewsFilteredPaginated(text: String, pageNumber: Int, pageSize: Int, sortBy: String, sortDirection: String): [News]
    getNewsById(id: Long!): News

    getAllMembers: [Member]
    getMemberById(id: Long!): Member
    getMemberByEmail(email: String!): Member
    getMembersFiltered(text: String): [Member]
    getMembersCount: Long

    getAllEvents: [Event]
    getEventsCount: Long
    getEventsByYear(year: Int!): [Event]
    getEventsByMonthAndYear(month: Int!, year: Int!): [Event]
    getEventsByDayAndMonthAndYear(day: Int!, month: Int!, year: Int!): [Event]
    getEventById(id: Long!): Event
    getEventsByTitle(title: String!): [Event]

    getAllOrganizers: [Organizer]

    getAllCountries: [Country]

    getAllTracks: [Track]
    getTrackById(id: Long!): Track

    getAllCircuits: [Circuit]
    getCircuitById(id: Long!): Circuit
    getCircuitsFiltered(text: String): [Circuit]

    getAllLapRecords: [LapRecord]
    getMemberLapRecords(memberId: Long!): [LapRecord]
    getTrackLapRecords(trackId: Long!): [LapRecord]
    getMyLapRecords: [LapRecord]

    getMyTrustedDevices(deviceSecret: String): [TrustedDevice]
}

type Mutation {
    createNews(title: String!, catchLine: String!, content: String!, newsDate: String!, memberId: Long!): News
    updateNews(newsId: Long!, title: String!, catchLine: String!, content: String!, newsDate: String!, memberId: Long!): News
    deleteNews(newsId: Long!): News
    likeNews(newsId: Long!, memberId: Long!): News
    unlikeNews(newsId: Long!, memberId: Long!): News

    createMember(firstName: String!, lastName: String!, email: String!, phone: String, riderNumber: Int, avatarFile: String, avatarFileName: String, role: Role!): Member
    updateMember(memberId: Long!, firstName: String!, lastName: String!, email: String!, phone: String, riderNumber: Int, avatarFile: String, avatarFileName: String, role: Role!): Member
    deleteMember(memberId: Long!): Member
    setBoardRole(memberId: Long!, boardRole: BoardRole): Member
    setMemberPalette(memberId: Long!, headerPalette: Int): Member
    changePasscode(currentPasscode: String!, newPasscode: String!): Boolean
    trustCurrentDevice(deviceSecret: String!, deviceLabel: String): Boolean
    revokeTrustedDevice(deviceId: Long!): Boolean

    createEvent(title: String!, description: String!, startDate: String!, endDate: String!, trackId: Long!, organizerId: Long!, price: Float!, memberId: Long!): Event
    updateEvent(eventId: Long!, title: String!, description: String!, startDate: String!, endDate: String!, trackId: Long!, organizerId: Long!, price: Float!, memberId: Long!): Event
    deleteEvent(eventId: Long!): Event
    registerToEvent(eventId: Long!, memberId: Long!, bikeId: Long): Event
    unregisterFromEvent(eventId: Long!, memberId: Long!): Event
    setEventMemberBike(eventId: Long!, bikeId: Long): Event
    setEventSessions(eventId: Long!, groups: [EventSessionGroupInput!]!): Event
    setEventMemberSessions(eventId: Long!, skippedSessionIds: [Long!]!): Event

    createOrganizer(name: String!): Organizer

    createCircuit(name: String!, countryCode: String!, latitude: Float!, longitude: Float!, website: String): Circuit
    updateCircuit(circuitId: Long!, name: String!, countryCode: String!, latitude: Float!, longitude: Float!, website: String): Circuit
    deleteCircuit(circuitId: Long!): Circuit

    createTrack(circuitId: Long!, variantName: String, distance: Int!, lapRecord: Int!, lapRecordInfo: String, iconKey: String): Track
    updateTrack(trackId: Long!, circuitId: Long!, variantName: String, distance: Int!, lapRecord: Int!, lapRecordInfo: String, iconKey: String): Track
    deleteTrack(trackId: Long!): Track

    createLapRecord(memberId: Long!, trackId: Long!, bikeId: Long!, recordDate: String!, lapTime: Int!, conditions: String!, comments: String, isPublic: Boolean): LapRecord
    updateLapRecord(lapRecordId: Long!, trackId: Long!, bikeId: Long!, recordDate: String!, lapTime: Int!, conditions: String!, comments: String, isPublic: Boolean): LapRecord
    deleteLapRecord(lapRecordId: Long!): LapRecord

    addBikeToMember(memberId: Long!, manufacturer: String!, modelName: String!, engineSize: Int, year: Int): Bike
    updateBike(bikeId: Long!, manufacturer: String!, modelName: String!, engineSize: Int, year: Int, current: Boolean): Bike
    deleteBike(bikeId: Long!): Bike

    addMembershipFee(memberId: Long!, year: Int!, amount: Float!, paid: Boolean!): MembershipFee
    updateMembershipFee(feeId: Long!, year: Int!, amount: Float!, paid: Boolean!): MembershipFee
    deleteMembershipFee(feeId: Long!): MembershipFee
}

type NewsListProjection {
    id: ID!
    title: String!
    catchLine: String!
    newsDate: LocalDateTime!
}

type NewsDetailsProjection {
    id: ID!
    title: String!
    content: String!
    newsDate: LocalDateTime!
    createdBy: String!
}

type Bike {
    id: ID!
    manufacturer: String!
    modelName: String!
    engineSize: Int
    year: Int
    current: Boolean!
}

type MembershipFee {
    id: ID!
    member: Member
    year: Int!
    amount: Float!
    paid: Boolean!
    createdOn: LocalDateTime!
    modifiedOn: LocalDateTime
}

type Event {
    id: ID!
    title: String!
    description: String
    startDate: LocalDateTime!
    endDate: LocalDateTime!
    track: Track
    organizer: Organizer
    price: Float
    participants: [EventMember]
    sessions: [EventSession]
    createdOn: LocalDateTime!
    createdBy: Member!
    modifiedOn: LocalDateTime
    modifiedBy: Member
}

type Organizer {
    id: ID!
    name: String!
}

type EventMember {
    id: ID!
    member: Member!
    event: Event!
    bike: Bike
    skippedSessions: [EventSession]
    createdOn: LocalDateTime!
}

type EventSession {
    id: ID!
    position: Int!
    durationMinutes: Int!
}

"A group of identical sessions as entered by an admin, e.g. 5 x 20 min, expanded server-side into individual sessions."
input EventSessionGroupInput {
    count: Int!
    durationMinutes: Int!
}

type LapRecord {
    id: ID!
    track: Track!
    member: Member
    bike: Bike!
    lapTime: Int!
    recordDate: LocalDateTime!
    conditions: String!
    comments: String
    isPublic: Boolean!
    createdOn: LocalDateTime!
    modifiedOn: LocalDateTime
}

type TrustedDevice {
    id: ID!
    label: String
    createdOn: LocalDateTime!
    lastUsedOn: LocalDateTime
    current: Boolean!
}

type LikedNews {
    id: ID!
    member: Member
    news: News!
    createdOn: LocalDateTime!
}

type Member {
    id: ID!
    firstName: String!
    lastName: String!
    email: String!
    password: String!
    phone: String
    riderNumber: Int
    headerPalette: Int
    hasAvatar: Boolean!
    bikes: [Bike]
    membershipFees: [MembershipFee]
    role: Role!
    boardRole: BoardRole
    eventMembers: [EventMember]
    likedNews: [LikedNews]
    registrationDate: LocalDateTime
    createdOn: LocalDateTime!
    modifiedOn: LocalDateTime
}

enum Role {
    ROLE_USER
    ROLE_GUEST
    ROLE_MEMBER
    ROLE_ADMIN
}

enum BoardRole {
    PRESIDENT
    VICE_PRESIDENT
    SECRETARY
    TREASURER
}

type News {
    id: ID!
    title: String!
    catchLine: String!
    content: String!
    newsDate: LocalDateTime
    likedNews: [LikedNews]
    createdOn: LocalDateTime!
    createdBy: Member!
    modifiedOn: LocalDateTime
    modifiedBy: Member
}

type Circuit {
    id: ID!
    name: String!
    country: Country!
    latitude: Float
    longitude: Float
    website: String
    tracks: [Track]
}

type Track {
    id: ID!
    circuit: Circuit
    variantName: String
    distance: Int
    lapRecord: Int
    lapRecordInfo: String
    iconKey: String
}

type Country {
    code: String!
    nameFr: String!
    nameEn: String!
}